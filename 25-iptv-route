#!/bin/sh
# iptv 接口 up 时按 /etc/iptv.conf 持久化业务网段路由
# 部署: /etc/hotplug.d/iface/25-iptv-route

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "iptv" ] || exit 0
[ -r /etc/iptv.conf ] && . /etc/iptv.conf
[ -n "$IGMP_GW" ] || exit 0

for net in "$IGMP_NET" "$TOKEN_NET" "$EDS_NET"; do
    [ -n "$net" ] && ip route replace "$net" via "$IGMP_GW" dev iptv metric 20
done
